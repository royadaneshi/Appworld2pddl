          "field": "product_id of the result whose name == \"HP Pavilion 15 Laptop\"",
          "object": "hp-pavilion-15-laptop"
        },
        "query": "battery",
        "is_verified": true
      }
    },
    {
      "step": 4,
      "pddl": "(amazon-show-product-question-answers battery-question verified-true hp-pavilion-15-laptop)",
      "api": "amazon.show_product_question_answers",
      "args": {
        "question_id": {
          "$from": "amazon.show_product_questions",
          "field": "question_id of the question asking about battery life/hours",
          "object": "battery-question"
