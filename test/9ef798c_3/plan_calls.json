{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(venmo-login anita-burch-at-gmail-com venmo-password venmo-token)",
      "api": "venmo.login",
      "args": {
        "username": "anita.burch@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"venmo\"",
          "object": "venmo-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(venmo-show-payment-cards venmo-token payment-card-1)",
      "api": "venmo.show_payment_cards",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(venmo-show-received-payment-requests venmo-token query-carpool sabrina-carpool-request)",
      "api": "venmo.show_received_payment_requests",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        },
        "query": "carpool"
      }
    },
    {
      "step": 5,
      "pddl": "(venmo-show-venmo-balance venmo-token)",
      "api": "venmo.show_venmo_balance",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(venmo-add-to-venmo-balance amount-1 payment-card-1 venmo-token sabrina-carpool-request)",
      "api": "venmo.add_to_venmo_balance",
      "args": {
        "amount": {
          "$from": "venmo.show_venmo_balance",
          "field": "the carpool request's amount (from venmo.show_received_payment_requests) minus venmo_balance: the shortfall that must be added before approving",
          "object": "amount-1"
        },
        "payment_card_id": {
          "$from": "venmo.show_payment_cards",
          "field": "payment_card_id of a card that has not expired (expiry_year / expiry_month not before the current date)",
          "object": "payment-card-1"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(venmo-approve-payment-request sabrina-carpool-request venmo-token)",
      "api": "venmo.approve_payment_request",
      "args": {
        "payment_request_id": {
          "$from": "venmo.show_received_payment_requests",
          "field": "payment_request_id of the pending request whose sender.first_name == \"Sabrina\" and whose description is about carpooling",
          "object": "sabrina-carpool-request"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 8,
      "pddl": "(supervisor-complete-task sabrina-carpool-request)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
