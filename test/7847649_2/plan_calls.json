{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(simple-note-login ta-weav-at-gmail-com simple-note-password simple-note-token)",
      "api": "simple_note.login",
      "args": {
        "username": "ta.weav@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"simple_note\"",
          "object": "simple-note-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(simple-note-search-notes simple-note-token query-bucket-list bucket-list-note)",
      "api": "simple_note.search_notes",
      "args": {
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        },
        "query": "bucket list"
      }
    },
    {
      "step": 4,
      "pddl": "(simple-note-show-note bucket-list-note simple-note-token count-remaining)",
      "api": "simple_note.show_note",
      "args": {
        "note_id": {
          "$from": "simple_note.search_notes",
          "field": "note_id of the note whose title refers to the bucket list",
          "object": "bucket-list-note"
        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(supervisor-complete-task count-remaining)",
      "api": "supervisor.complete_task",
      "args": {
        "answer": {
          "$from": "simple_note.show_note",
          "field": "content: number of bucket-list items not marked as done/completed",
          "object": "count-remaining"
        }
      }
    }
  ],
  "problems": []
}