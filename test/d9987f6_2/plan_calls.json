{
  "calls": [
    {
      "step": 1,
      "pddl": "(amazon-search-products query-gaming-console-controller rating-3-8 gaming-console-controller)",
      "api": "amazon.search_products",
      "args": {
        "query": "gaming console controller",
        "min_product_rating": 3.8
      }
    },
    {
      "step": 2,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 3,
      "pddl": "(amazon-login pa-ritter-at-gmail-com amazon-password amazon-token)",
      "api": "amazon.login",
      "args": {
        "username": "pa_ritter@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"amazon\"",
          "object": "amazon-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(amazon-clear-cart amazon-token)",
      "api": "amazon.clear_cart",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(amazon-add-product-to-cart gaming-console-controller amazon-token quantity-1)",
      "api": "amazon.add_product_to_cart",
      "args": {
        "product_id": {
          "$from": "amazon.search_products",
          "field": "product_id of a result whose product_type == \"gaming console controller\" and rating > 3.8 (strictly greater)",
          "object": "gaming-console-controller"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        },
        "quantity": 1
      }
    },
    {
      "step": 6,
      "pddl": "(amazon-show-addresses amazon-token work-address)",
      "api": "amazon.show_addresses",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(amazon-show-payment-cards amazon-token payment-card-1)",
      "api": "amazon.show_payment_cards",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 8,
      "pddl": "(amazon-place-order payment-card-1 work-address amazon-token gaming-console-controller)",
      "api": "amazon.place_order",
      "args": {
        "payment_card_id": {
          "$from": "amazon.show_payment_cards",
          "field": "payment_card_id of a card that has not expired (expiry_year / expiry_month not before the current date)",
          "object": "payment-card-1"
        },
        "address_id": {
          "$from": "amazon.show_addresses",
          "field": "address_id where name == \"Work\"",
          "object": "work-address"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 9,
      "pddl": "(supervisor-complete-task gaming-console-controller work-address)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
