{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(amazon-login an-harrison-at-gmail-com-username amazon-password amazon-token)",
      "api": "amazon.login",
      "args": {
        "username": "an-harrison@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"amazon\"",
          "object": "amazon-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(amazon-show-orders amazon-token query-sweater last-sweater-order)",
      "api": "amazon.show_orders",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        },
        "query": "sweater"
      }
    },
    {
      "step": 4,
      "pddl": "(amazon-show-order last-sweater-order amazon-token sweater-product)",
      "api": "amazon.show_order",
      "args": {
        "order_id": {
          "$from": "amazon.show_orders",
          "field": "order_id of the most recent order whose products include a sweater",
          "object": "last-sweater-order"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(amazon-show-product-questions sweater-product an-harrison-at-gmail-com my-sweater-question)",
      "api": "amazon.show_product_questions",
      "args": {
        "product_id": {
          "$from": "amazon.show_order",
          "field": "products[].product_id of the sweater item in that order",
          "object": "sweater-product"
        },
        "user_email": "an-harrison@gmail.com"
      }
    },
    {
      "step": 6,
      "pddl": "(amazon-show-product-question-answers my-sweater-question answer-yes-or-no)",
      "api": "amazon.show_product_question_answers",
      "args": {
        "question_id": {
          "$from": "amazon.show_product_questions",
          "field": "question_id of the question posted by the supervisor (user_email filter)",
          "object": "my-sweater-question"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(supervisor-complete-task answer-yes-or-no)",
      "api": "supervisor.complete_task",
      "args": {
        "answer": {
          "$from": "amazon.show_product_question_answers",
          "field": "\"yes\" if any answer reports color fading after the first wash, otherwise \"no\"",
          "object": "answer-yes-or-no"
        }
      }
    }
  ],
  "problems": []
}