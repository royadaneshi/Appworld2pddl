{
  "calls": [
    {
      "step": 1,
      "pddl": "(amazon-search-products product-type-desk-organizer rating-4-3 rating-4-1 desk-organizer-product)",
      "api": "amazon.search_products",
      "args": {
        "product_type": "desk organizer",
        "min_product_rating": 4.3,
        "min_seller_rating": 4.1
      }
    },
    {
      "step": 2,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 3,
      "pddl": "(amazon-login masmith-at-gmail-com amazon-password amazon-token)",
      "api": "amazon.login",
      "args": {
        "username": "masmith@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"amazon\"",
          "object": "amazon-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(amazon-clear-cart amazon-token)",
      "api": "amazon.clear_cart",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(amazon-add-product-to-cart desk-organizer-product amazon-token quantity-2)",
      "api": "amazon.add_product_to_cart",
      "args": {
        "product_id": {
          "$from": "amazon.search_products",
          "field": "product_id of any returned product (search already filtered by product_type == \"desk organizer\", min_product_rating 4.3, min_seller_rating 4.1)",
          "object": "desk-organizer-product"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        },
        "quantity": 2
      }
    },
    {
      "step": 6,
      "pddl": "(amazon-show-payment-cards amazon-token payment-card-1)",
      "api": "amazon.show_payment_cards",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(supervisor-show-addresses)",
      "api": "supervisor.show_addresses",
      "args": {}
    },
    {
      "step": 8,
      "pddl": "(amazon-show-addresses amazon-token work-address)",
      "api": "amazon.show_addresses",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 9,
      "pddl": "(amazon-place-order payment-card-1 work-address amazon-token order-1 desk-organizer-product quantity-2)",
      "api": "amazon.place_order",
      "args": {
        "payment_card_id": {
          "$from": "amazon.show_payment_cards",
          "field": "payment_card_id (any card, e.g. the first one)",
          "object": "payment-card-1"
        },
        "address_id": {
          "$from": "amazon.show_addresses",
          "field": "address_id of the address whose name == \"Work\" (text matches the work address from supervisor.show_addresses)",
          "object": "work-address"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 10,
      "pddl": "(supervisor-complete-task order-1 desk-organizer-product quantity-2 work-address)",
      "api": "supervisor.complete_task",
      "args": {}
