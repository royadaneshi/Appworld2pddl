      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(simple-note-login chris-mcco-at-gmail-com simple-note-password simple-note-token)",
      "api": "simple_note.login",
      "args": {
        "username": "chris.mcco@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"simple_note\"",
          "object": "simple-note-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(venmo-login chris-mcco-at-gmail-com venmo-password venmo-token)",
      "api": "venmo.login",
      "args": {
        "username": "chris.mcco@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"venmo\"",
          "object": "venmo-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(simple-note-search-notes simple-note-token query-venmo-expenses venmo-expenses-note)",
      "api": "simple_note.search_notes",
      "args": {
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        },
        "query": "venmo expenses"
      }
    },
    {
      "step": 5,
      "pddl": "(simple-note-show-note venmo-expenses-note simple-note-token)",
      "api": "simple_note.show_note",
      "args": {
        "note_id": {
          "$from": "simple_note.search_notes",
          "field": "note_id of the note whose title is the monthly Venmo expenses log",
          "object": "venmo-expenses-note"
        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(venmo-show-transactions venmo-token datetime-2023-05-01 datetime-2023-05-31 direction-sent this-month-expense)",
      "api": "venmo.show_transactions",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        },
        "min_created_at": "2023-05-01T00:00:00",
        "max_created_at": "2023-05-31T23:59:59",
        "direction": "sent"
      }
    },
    {
      "step": 7,
      "pddl": "(simple-note-update-note venmo-expenses-note simple-note-token new-content this-month-expense)",
      "api": "simple_note.update_note",
      "args": {
        "note_id": {
          "$from": "simple_note.search_notes",
          "field": "note_id of the note whose title is the monthly Venmo expenses log",
          "object": "venmo-expenses-note"
        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        },
        "content": {
          "$from": "simple_note.show_note",
          "field": "content, keeping the '# Venmo Expenses' header and existing '- MM/YY => $X' lines, with a new line '- 05/23 => $<this-month-expense>' inserted so the months keep the note's existing chronological order (ascending: append at end; descending: insert right after the header)",
          "object": "new-content"
        }
      }
    },
    {
      "step": 8,
      "pddl": "(supervisor-complete-task venmo-expenses-note this-month-expense)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
  "problems": []
