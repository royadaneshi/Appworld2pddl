        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(amazon-show-payment-cards amazon-token amazon-card)",
      "api": "amazon.show_payment_cards",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 8,
      "pddl": "(amazon-place-order amazon-card home-address amazon-token cooling-fan)",
      "api": "amazon.place_order",
      "args": {
        "payment_card_id": {
          "$from": "amazon.show_payment_cards",
          "field": "payment_card_id of a valid (non-expired) card, e.g. the first one",
          "object": "amazon-card"
        },
        "address_id": {
          "$from": "amazon.show_addresses",
          "field": "address_id where name == \"Home\"",
