{
  "calls": [
    {
      "step": 1,
      "pddl": "(amazon-search-products query-cooling-fan type-cooling-fan price-20 cooling-fan)",
      "api": "amazon.search_products",
      "args": {
        "query": "cooling fan",
        "product_type": "cooling fan",
        "max_price": 20
      }
    },
    {
      "step": 2,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 3,
      "pddl": "(amazon-login hun-weaver-at-gmail-com amazon-password amazon-token)",
