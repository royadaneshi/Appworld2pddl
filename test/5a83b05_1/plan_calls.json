{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(file-system-login jefsmith-at-gmail-com file-system-password file-system-token)",
      "api": "file_system.login",
      "args": {
        "username": "jefsmith@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"file_system\"",
          "object": "file-system-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(file-system-show-directory file-system-token dir-downloads substring-pdf)",
      "api": "file_system.show_directory",
      "args": {
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
        "directory_path": "~/downloads",
        "substring": ".pdf"
      }
    },
    {
      "step": 4,
      "pddl": "(file-system-delete-file pdf-file-1 file-system-token dir-downloads substring-pdf)",
      "api": "file_system.delete_file",
      "args": {
        "file_path": {
          "$from": "file_system.show_directory",
          "field": "path of the 1st returned file entry whose path ends with .pdf",
          "object": "pdf-file-1"
        },
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(file-system-delete-file pdf-file-2 file-system-token dir-downloads substring-pdf)",
      "api": "file_system.delete_file",
      "args": {
        "file_path": {
          "$from": "file_system.show_directory",
          "field": "path of the 2nd returned file entry whose path ends with .pdf",
          "object": "pdf-file-2"
        },
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(supervisor-complete-task pdf-file-1 pdf-file-2)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
  "problems": []
