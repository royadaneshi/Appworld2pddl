{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(amazon-login jasonsimp-at-gmail-com amazon-password amazon-token)",
      "api": "amazon.login",
      "args": {
        "username": "jasonsimp@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"amazon\"",
          "object": "amazon-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(amazon-show-cart amazon-token)",
      "api": "amazon.show_cart",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(amazon-show-wish-list amazon-token)",
      "api": "amazon.show_wish_list",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(supervisor-complete-task total-cart-and-wishlist-cost)",
      "api": "supervisor.complete_task",
      "args": {
        "answer": {
          "$from": "amazon.show_cart",
          "field": "sum(price * quantity) over cart products plus sum(price * quantity) over products returned by amazon.show_wish_list (tax and delivery fees excluded)",
          "object": "total-cart-and-wishlist-cost"
        }
      }
    }
  ],
