      }
    },
    {
      "step": 4,
      "pddl": "(supervisor-complete-task days-remaining premium-subscription)",
      "api": "supervisor.complete_task",
      "args": {
        "answer": {
          "$from": "spotify.show_premium_subscriptions",
          "field": "round((end_date of the currently active premium subscription - current datetime 2023-05-19T00:00:10) in days); integer answer",
          "object": "days-remaining"
        }
      }
    }
