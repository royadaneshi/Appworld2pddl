{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(amazon-login connorbrow-at-gmail-com amazon-password amazon-token)",
      "api": "amazon.login",
      "args": {
