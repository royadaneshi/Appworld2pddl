        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(simple-note-show-note habit-log-note-2 simple-note-token query-habit limited-screen-time-to-1-hr longest-streak-days)",
      "api": "simple_note.show_note",
      "args": {
        "note_id": {
          "$from": "simple_note.search_notes",
          "field": "note_id of the second habit-tracking log note in the results",
          "object": "habit-log-note-2"
        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(supervisor-complete-task longest-streak-days limited-screen-time-to-1-hr habit-log-note-1 habit-log-note-2)",
