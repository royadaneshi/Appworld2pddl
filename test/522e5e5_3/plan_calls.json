{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(venmo-login jasonsimp-at-gmail-com venmo-password venmo-token)",
      "api": "venmo.login",
      "args": {
        "username": "jasonsimp@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"venmo\"",
          "object": "venmo-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(venmo-show-transactions venmo-token datetime-2023-05-01t00-00-00 direction-received)",
      "api": "venmo.show_transactions",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        },
        "min_created_at": "2023-05-01T00:00:00",
        "direction": "received"
      }
    },
    {
      "step": 4,
      "pddl": "(venmo-add-friend sender-1-email venmo-token sender-1)",
      "api": "venmo.add_friend",
      "args": {
        "user_email": {
          "$from": "venmo.show_transactions",
          "field": "sender.email of 1st distinct sender among transactions with direction=received and created_at >= 2023-05-01 (skip senders who are already friends)",
          "object": "sender-1-email"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(venmo-add-friend sender-2-email venmo-token sender-2)",
      "api": "venmo.add_friend",
      "args": {
        "user_email": {
          "$from": "venmo.show_transactions",
          "field": "sender.email of 2nd distinct sender among transactions with direction=received and created_at >= 2023-05-01 (skip senders who are already friends)",
          "object": "sender-2-email"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(supervisor-complete-task sender-1 sender-2)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
