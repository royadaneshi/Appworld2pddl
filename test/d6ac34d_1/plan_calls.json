{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(simple-note-login anita-burch-at-gmail-com simple-note-password simple-note-token)",
      "api": "simple_note.login",
      "args": {
        "username": "anita.burch@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"simple_note\"",
          "object": "simple-note-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(simple-note-search-notes simple-note-token query-habit yesterday-habit-log)",
      "api": "simple_note.search_notes",
      "args": {
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        },
        "query": "habit"
      }
    },
    {
      "step": 4,
      "pddl": "(simple-note-show-note yesterday-habit-log simple-note-token)",
      "api": "simple_note.show_note",
      "args": {
        "note_id": {
          "$from": "simple_note.search_notes",
          "field": "note_id of the habit tracking log note for yesterday (2023-05-17)",
          "object": "yesterday-habit-log"
        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(simple-note-create-note title-today content-today simple-note-token habit-tags pinned-as-yesterday today-habit-log yesterday-habit-log)",
      "api": "simple_note.create_note",
      "args": {
        "title": {
          "$from": "simple_note.show_note",
          "field": "title of yesterday's note with the date replaced by today's date (2023-05-18)",
          "object": "title-today"
        },
        "content": {
          "$from": "simple_note.show_note",
          "field": "content of yesterday's note with the header date updated to today and the 'had a good posture' entry set to done/yes; all other entries unchanged",
          "object": "content-today"
        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        },
        "tags": {
          "$from": "simple_note.show_note",
          "field": "tags",
          "object": "habit-tags"
        },
        "pinned": {
          "$from": "simple_note.show_note",
          "field": "pinned",
          "object": "pinned-as-yesterday"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(supervisor-complete-task)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
  "problems": []
}