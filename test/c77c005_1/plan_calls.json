          "object": "email-recent-payee-1"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(venmo-add-friend email-recent-payee-2 venmo-token recent-payee-2)",
      "api": "venmo.add_friend",
      "args": {
        "user_email": {
          "$from": "venmo.show_transactions",
          "field": "counterpart email of another this-month transaction whose user is not yet a friend",
          "object": "email-recent-payee-2"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
