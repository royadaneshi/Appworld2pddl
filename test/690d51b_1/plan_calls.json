          "field": "product_id of a result whose product_type == \"kitchen timer\" and price <= 10",
          "object": "kitchen-timer-product"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        },
        "quantity": 1
      }
    },
    {
      "step": 5,
      "pddl": "(amazon-show-addresses amazon-token address-home)",
      "api": "amazon.show_addresses",
      "args": {
