      "args": {
        "username": "bradley_ball@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"amazon\"",
          "object": "amazon-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(amazon-add-product-to-cart kitchen-timer-product amazon-token quantity-1)",
