          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(amazon-show-payment-cards amazon-token payment-card-main)",
      "api": "amazon.show_payment_cards",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(amazon-place-order payment-card-main address-home amazon-token kitchen-timer-product quantity-1)",
      "api": "amazon.place_order",
      "args": {
        "payment_card_id": {
          "$from": "amazon.show_payment_cards",
          "field": "payment_card_id (any card on the account)",
          "object": "payment-card-main"
        },
        "address_id": {
          "$from": "amazon.show_addresses",
          "field": "address_id where name == \"Home\"",
          "object": "address-home"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
