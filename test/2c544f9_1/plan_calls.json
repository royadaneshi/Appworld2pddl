{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(venmo-login brandon-webe-at-gmail-com venmo-password venmo-token)",
      "api": "venmo.login",
      "args": {
        "username": "brandon-webe@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"venmo\"",
          "object": "venmo-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(venmo-search-friends venmo-token query-catherine catherine catherine-email)",
      "api": "venmo.search_friends",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        },
        "query": "Catherine"
      }
    },
    {
      "step": 4,
      "pddl": "(venmo-show-payment-cards venmo-token venmo-card)",
      "api": "venmo.show_payment_cards",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(venmo-show-venmo-balance venmo-token)",
      "api": "venmo.show_venmo_balance",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(venmo-create-transaction catherine-email amount-250 venmo-token venmo-card catherine txn-catherine-250)",
      "api": "venmo.create_transaction",
      "args": {
        "receiver_email": {
          "$from": "venmo.search_friends",
          "field": "email of the friend whose first_name == \"Catherine\"",
          "object": "catherine-email"
        },
        "amount": 250,
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        },
        "payment_card_id": {
          "$from": "venmo.show_payment_cards",
          "field": "id of a payment card (first listed) used to fund the transfer if balance is insufficient",
          "object": "venmo-card"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(supervisor-complete-task txn-catherine-250 catherine amount-250)",
      "api": "supervisor.complete_task",
      "args": {}
    }
