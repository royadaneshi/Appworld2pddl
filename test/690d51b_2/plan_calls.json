{
  "calls": [
    {
      "step": 1,
      "pddl": "(amazon-search-products query-coffee-maker type-coffee-maker price-150 coffee-maker-product)",
      "api": "amazon.search_products",
      "args": {
        "query": "coffee maker",
        "product_type": "coffee maker",
        "max_price": 150
      }
    },
    {
      "step": 2,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 3,
      "pddl": "(amazon-login ka-ball-at-gmail-com amazon-password amazon-token)",
      "api": "amazon.login",
      "args": {
        "username": "ka_ball@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"amazon\"",
          "object": "amazon-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(amazon-add-product-to-cart coffee-maker-product amazon-token quantity-1 true-flag)",
      "api": "amazon.add_product_to_cart",
      "args": {
        "product_id": {
          "$from": "amazon.search_products",
          "field": "product_id of a result with product_type == \"coffee maker\" and price <= 150 (first such result)",
          "object": "coffee-maker-product"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        },
        "quantity": 1,
        "clear_cart_first": true
      }
    },
    {
      "step": 5,
      "pddl": "(amazon-show-addresses amazon-token work-address)",
      "api": "amazon.show_addresses",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(amazon-show-payment-cards amazon-token amazon-payment-card)",
      "api": "amazon.show_payment_cards",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(amazon-place-order amazon-payment-card work-address amazon-token coffee-maker-product quantity-1 coffee-maker-order)",
      "api": "amazon.place_order",
      "args": {
        "payment_card_id": {
          "$from": "amazon.show_payment_cards",
          "field": "payment_card_id (any card on file, e.g. the first)",
          "object": "amazon-payment-card"
        },
        "address_id": {
          "$from": "amazon.show_addresses",
          "field": "address_id where name == \"Work\"",
          "object": "work-address"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 8,
      "pddl": "(supervisor-complete-task coffee-maker-order coffee-maker-product quantity-1 work-address)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
  "problems": []
}