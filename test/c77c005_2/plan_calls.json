{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(venmo-login angelica-wils-at-gmail-com venmo-password venmo-token)",
      "api": "venmo.login",
      "args": {
        "username": "angelica.wils@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"venmo\"",
          "object": "venmo-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(venmo-search-friends venmo-token)",
      "api": "venmo.search_friends",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(venmo-show-transactions venmo-token datetime-2023-05-01t00-00-00 direction-sent)",
      "api": "venmo.show_transactions",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        },
        "min_created_at": "2023-05-01T00:00:00",
        "direction": "sent"
      }
    },
    {
      "step": 5,
      "pddl": "(venmo-add-friend email-payee-new venmo-token payee-new old-friend-1)",
      "api": "venmo.add_friend",
      "args": {
        "user_email": {
          "$from": "venmo.show_transactions",
          "field": "receiver.email of a sent transaction with created_at >= 2023-05-01 (deduplicated) whose receiver is NOT in the venmo.search_friends result",
          "object": "email-payee-new"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(venmo-remove-friend email-old-friend-1 venmo-token old-friend-1 old-friend-2)",
      "api": "venmo.remove_friend",
      "args": {
        "user_email": {
          "$from": "venmo.search_friends",
          "field": "email of a current friend who is not a receiver of any sent transaction this month",
          "object": "email-old-friend-1"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(venmo-remove-friend email-old-friend-2 venmo-token old-friend-2 worklist-end)",
      "api": "venmo.remove_friend",
      "args": {
        "user_email": {
          "$from": "venmo.search_friends",
          "field": "email of a current friend who is not a receiver of any sent transaction this month",
          "object": "email-old-friend-2"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 8,
      "pddl": "(supervisor-complete-task)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
