{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(file-system-login sab-brown-at-gmail-com file-system-password file-system-token)",
      "api": "file_system.login",
      "args": {
        "username": "sab-brown@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"file_system\"",
          "object": "file-system-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(gmail-login sab-brown-at-gmail-com gmail-password gmail-token)",
      "api": "gmail.login",
      "args": {
        "username": "sab-brown@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"gmail\"",
          "object": "gmail-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(gmail-show-inbox-threads gmail-token query-amazon)",
      "api": "gmail.show_inbox_threads",
      "args": {
        "access_token": {
          "$from": "gmail.login",
          "field": "access_token",
          "object": "gmail-token"
        },
        "query": "amazon"
      }
    },
    {
      "step": 5,
      "pddl": "(gmail-show-email confirmation-email-1 gmail-token amazon-order-1)",
      "api": "gmail.show_email",
      "args": {
        "email_id": {
          "$from": "gmail.show_inbox_threads",
          "field": "email_ids of the 1st Amazon order-confirmation thread (paginate through all pages; keep only order confirmation emails)",
          "object": "confirmation-email-1"
        },
        "access_token": {
          "$from": "gmail.login",
          "field": "access_token",
          "object": "gmail-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(gmail-download-attachment receipt-attachment-1 file-system-token gmail-token receipt-path-1 amazon-order-1)",
      "api": "gmail.download_attachment",
      "args": {
        "attachment_id": {
          "$from": "gmail.show_email",
          "field": "attachments[].id of the receipt attachment in confirmation-email-1",
          "object": "receipt-attachment-1"
        },
        "file_system_access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
        "access_token": {
          "$from": "gmail.login",
          "field": "access_token",
          "object": "gmail-token"
        },
        "download_to_file_path": {
          "$from": "gmail.show_email",
          "field": "\"~/bills/amazon/ordered_at_<yyyy-mm-dd>_order_id_<order_id>.txt\" built from the order id and order-placed date found in confirmation-email-1 (body / receipt / sent date)",
          "object": "receipt-path-1"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(gmail-show-email confirmation-email-2 gmail-token amazon-order-2)",
      "api": "gmail.show_email",
      "args": {
        "email_id": {
          "$from": "gmail.show_inbox_threads",
          "field": "email_ids of the 2nd Amazon order-confirmation thread (one per Amazon order)",
          "object": "confirmation-email-2"
        },
        "access_token": {
          "$from": "gmail.login",
          "field": "access_token",
          "object": "gmail-token"
        }
      }
    },
    {
      "step": 8,
      "pddl": "(gmail-download-attachment receipt-attachment-2 file-system-token gmail-token receipt-path-2 amazon-order-2)",
      "api": "gmail.download_attachment",
      "args": {
        "attachment_id": {
          "$from": "gmail.show_email",
          "field": "attachments[].id of the receipt attachment in confirmation-email-2",
          "object": "receipt-attachment-2"
        },
        "file_system_access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
        "access_token": {
          "$from": "gmail.login",
          "field": "access_token",
          "object": "gmail-token"
        },
        "download_to_file_path": {
          "$from": "gmail.show_email",
          "field": "\"~/bills/amazon/ordered_at_<yyyy-mm-dd>_order_id_<order_id>.txt\" built from the order id and order-placed date found in confirmation-email-2 (body / receipt / sent date)",
          "object": "receipt-path-2"
        }
      }
    },
    {
      "step": 9,
      "pddl": "(supervisor-complete-task amazon-order-1 amazon-order-2)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
