          "object": "inbox-fitting-task"
        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        }
      }
    },
    {
      "step": 11,
      "pddl": "(todoist-delete-task today-done-task simple-note-token today-project)",
