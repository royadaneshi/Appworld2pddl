        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        }
      }
    },
    {
      "step": 9,
      "pddl": "(todoist-create-task today-project title-of-inbox-fitting-task simple-note-token description-of-inbox-fitting-task duration-of-inbox-fitting-task unit-of-inbox-fitting-task priority-of-inbox-fitting-task inbox-fitting-task inbox-project)",
