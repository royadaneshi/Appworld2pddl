{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(venmo-login matthew-blac-at-gmail-com venmo-password venmo-token)",
      "api": "venmo.login",
      "args": {
        "username": "matthew.blac@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"venmo\"",
          "object": "venmo-password"
        }
      }
    },
    {
      "step": 3,
      "pddl": "(venmo-show-transactions venmo-token datetime-2023-05-01t00-00-00 direction-sent)",
      "api": "venmo.show_transactions",
      "args": {
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        },
        "min_created_at": "2023-05-01T00:00:00",
        "direction": "sent"
      }
    },
    {
      "step": 4,
      "pddl": "(venmo-add-friend recipient-1-email venmo-token recipient-1)",
      "api": "venmo.add_friend",
      "args": {
        "user_email": {
          "$from": "venmo.show_transactions",
          "field": "receiver.email of the 1st distinct receiver among transactions with direction=sent and created_at >= 2023-05-01 (skip users already friends)",
          "object": "recipient-1-email"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(venmo-add-friend recipient-2-email venmo-token recipient-2)",
      "api": "venmo.add_friend",
      "args": {
        "user_email": {
          "$from": "venmo.show_transactions",
          "field": "receiver.email of the 2nd distinct receiver among transactions with direction=sent and created_at >= 2023-05-01 (skip users already friends)",
          "object": "recipient-2-email"
        },
        "access_token": {
          "$from": "venmo.login",
          "field": "access_token",
          "object": "venmo-token"
        }
      }
    },
    {
