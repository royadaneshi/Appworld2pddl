{
  "calls": [
    {
      "step": 1,
      "pddl": "(amazon-search-products query-extension-cord rating-3-9 rating-4-0 extension-cord-product)",
      "api": "amazon.search_products",
      "args": {
        "query": "extension cord",
        "min_product_rating": 3.9,
        "min_seller_rating": 4
      }
    },
    {
      "step": 2,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 3,
      "pddl": "(amazon-login anita-burch-at-gmail-com amazon-password amazon-token)",
      "api": "amazon.login",
      "args": {
        "username": "anita.burch@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"amazon\"",
          "object": "amazon-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(amazon-clear-cart amazon-token)",
      "api": "amazon.clear_cart",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(amazon-add-product-to-cart extension-cord-product amazon-token quantity-3)",
      "api": "amazon.add_product_to_cart",
      "args": {
        "product_id": {
          "$from": "amazon.search_products",
          "field": "product_id of a result whose product_type == \"extension cord\" (search filtered by min_product_rating=3.9, min_seller_rating=4.0); pick the first such result",
          "object": "extension-cord-product"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        },
        "quantity": 3
      }
    },
    {
      "step": 6,
      "pddl": "(amazon-show-addresses amazon-token work-address)",
      "api": "amazon.show_addresses",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(amazon-show-payment-cards amazon-token payment-card-1)",
      "api": "amazon.show_payment_cards",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 8,
      "pddl": "(amazon-place-order payment-card-1 work-address amazon-token extension-cord-product quantity-3)",
      "api": "amazon.place_order",
      "args": {
        "payment_card_id": {
          "$from": "amazon.show_payment_cards",
          "field": "payment_card_id of the first (any valid) card",
          "object": "payment-card-1"
        },
        "address_id": {
          "$from": "amazon.show_addresses",
          "field": "address_id where name == \"Work\"",
          "object": "work-address"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 9,
      "pddl": "(supervisor-complete-task extension-cord-product quantity-3 work-address)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
  "problems": []
}