{
  "calls": [
    {
      "step": 1,
      "pddl": "(amazon-search-products query-extension-cord extension-cord rating-4-5 extension-cord-product)",
      "api": "amazon.search_products",
      "args": {
        "query": "extension cord",
        "product_type": "extension cord",
        "min_product_rating": 4.5
      }
    },
    {
      "step": 2,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 3,
      "pddl": "(amazon-login ad-blackburn-at-gmail-com amazon-password amazon-token)",
      "api": "amazon.login",
      "args": {
        "username": "ad.blackburn@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"amazon\"",
          "object": "amazon-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(amazon-clear-cart amazon-token)",
      "api": "amazon.clear_cart",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(amazon-add-product-to-cart extension-cord-product amazon-token quantity-1)",
      "api": "amazon.add_product_to_cart",
      "args": {
        "product_id": {
          "$from": "amazon.search_products",
          "field": "product_id of a result whose product_type == \"extension cord\" and rating > 4.5 (strictly greater; min_product_rating is inclusive, so skip exactly-4.5 results)",
          "object": "extension-cord-product"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        },
        "quantity": 1
      }
    },
    {
      "step": 6,
      "pddl": "(amazon-show-addresses amazon-token home-address)",
      "api": "amazon.show_addresses",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(amazon-show-payment-cards amazon-token payment-card-1)",
      "api": "amazon.show_payment_cards",
      "args": {
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 8,
      "pddl": "(amazon-place-order payment-card-1 home-address amazon-token extension-cord-product quantity-1)",
      "api": "amazon.place_order",
      "args": {
        "payment_card_id": {
          "$from": "amazon.show_payment_cards",
          "field": "payment_card_id of a card that has not expired (expiry_year / expiry_month not before the current date)",
          "object": "payment-card-1"
        },
        "address_id": {
          "$from": "amazon.show_addresses",
          "field": "address_id where name == \"Home\"",
          "object": "home-address"
        },
        "access_token": {
          "$from": "amazon.login",
          "field": "access_token",
          "object": "amazon-token"
        }
      }
    },
    {
      "step": 9,
      "pddl": "(supervisor-complete-task)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
  "problems": []
}