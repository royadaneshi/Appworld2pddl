      "api": "phone.get_current_date_and_time",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 3,
      "pddl": "(supervisor-show-profile)",
      "api": "supervisor.show_profile",
      "args": {}
    },
    {
      "step": 4,
      "pddl": "(file-system-login dav-mart-at-gmail-com file-system-password file-system-token)",
      "api": "file_system.login",
      "args": {
        "username": "dav.mart@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"file_system\"",
          "object": "file-system-password"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(file-system-show-directory file-system-token dir-my-downloads)",
      "api": "file_system.show_directory",
      "args": {
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
        "directory_path": "~/my_downloads/"
      }
    },
    {
      "step": 6,
      "pddl": "(file-system-show-file path-my-downloads-file-prior-year file-system-token file-prior-year dir-my-downloads)",
      "api": "file_system.show_file",
      "args": {
        "file_path": {
          "$from": "file_system.show_directory",
          "field": "entry of the returned path list whose show_file created_at year is earlier than the current year",
          "object": "path-my-downloads-file-prior-year"
        },
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(file-system-move-file path-my-downloads-file-prior-year path-archive-prefixed-file-prior-year file-system-token file-prior-year year-before-2023 dir-archive)",
      "api": "file_system.move_file",
      "args": {
        "source_file_path": {
          "$from": "file_system.show_directory",
          "field": "entry of the returned path list whose show_file created_at year is earlier than the current year",
          "object": "path-my-downloads-file-prior-year"
        },
        "destination_file_path": {
          "$from": "file_system.show_file",
          "field": "'~/archive/' + created_at formatted as YYYY_MM_DD_ + original file name (last segment of path)",
          "object": "path-archive-prefixed-file-prior-year"
        },
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        }
      }
    },
    {
      "step": 8,
      "pddl": "(file-system-show-file path-my-downloads-file-this-year file-system-token file-this-year dir-my-downloads)",
      "api": "file_system.show_file",
      "args": {
        "file_path": {
          "$from": "file_system.show_directory",
          "field": "entry of the returned path list whose show_file created_at year equals the current year (2023)",
          "object": "path-my-downloads-file-this-year"
        },
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        }
      }
    },
    {
      "step": 9,
      "pddl": "(file-system-move-file path-my-downloads-file-this-year path-my-downloads-prefixed-file-this-year file-system-token file-this-year year-2023 dir-my-downloads)",
      "api": "file_system.move_file",
      "args": {
        "source_file_path": {
          "$from": "file_system.show_directory",
          "field": "entry of the returned path list whose show_file created_at year equals the current year (2023)",
          "object": "path-my-downloads-file-this-year"
        },
        "destination_file_path": {
          "$from": "file_system.show_file",
          "field": "'~/my_downloads/' + created_at formatted as YYYY_MM_DD_ + original file name (last segment of path)",
          "object": "path-my-downloads-prefixed-file-this-year"
        },
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        }
      }
    },
    {
