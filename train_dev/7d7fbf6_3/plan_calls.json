          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
        "compressed_file_path": {
          "$from": "file_system.show_directory",
          "field": "derived: ~/pictures/vacations/<vacation_spot>.zip for 2nd sub-directory",
          "object": "vacation-zip-2"
        },
        "delete_directory": true,
        "overwrite": true
      }
    },
    {
      "step": 7,
      "pddl": "(file-system-compress-directory vacation-dir-3 file-system-token vacation-zip-3 flag-true flag-true pictures-vacations-dir)",
      "api": "file_system.compress_directory",
      "args": {
        "directory_path": {
          "$from": "file_system.show_directory",
          "field": "3rd listed sub-directory path (~/pictures/vacations/<vacation_spot>)",
          "object": "vacation-dir-3"
        },
