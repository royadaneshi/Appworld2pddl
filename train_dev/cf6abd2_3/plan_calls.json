{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(supervisor-show-profile)",
      "api": "supervisor.show_profile",
      "args": {}
    },
    {
      "step": 3,
      "pddl": "(simple-note-login ja-solomon-at-gmail-com simple-note-password simple-note-token)",
      "api": "simple_note.login",
      "args": {
        "username": "ja-solomon@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"simple_note\"",
          "object": "simple-note-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(simple-note-search-notes simple-note-token query-bucket-list bucket-list-note)",
      "api": "simple_note.search_notes",
      "args": {
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        },
        "query": "bucket list"
      }
    },
    {
      "step": 5,
      "pddl": "(simple-note-show-note bucket-list-note simple-note-token bucket-list-content)",
      "api": "simple_note.show_note",
      "args": {
        "note_id": {
          "$from": "simple_note.search_notes",
          "field": "note_id of the first result matching the Bucket List note",
          "object": "bucket-list-note"
        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(simple-note-update-note bucket-list-note simple-note-token bucket-list-content-eclipse-done witnessing-total-solar-eclipse bucket-list-content)",
      "api": "simple_note.update_note",
      "args": {
        "note_id": {
          "$from": "simple_note.search_notes",
          "field": "note_id of the first result matching the Bucket List note",
          "object": "bucket-list-note"
        },
        "access_token": {
          "$from": "simple_note.login",
          "field": "access_token",
          "object": "simple-note-token"
        },
        "content": {
          "$from": "simple_note.show_note",
          "field": "content with the line \"[ ] Witnessing a total solar eclipse\" replaced by \"[x] Witnessing a total solar eclipse\" (all other lines, title, tags, pinned unchanged)",
          "object": "bucket-list-content-eclipse-done"
        }
      }
    },
    {
      "step": 7,
      "pddl": "(supervisor-complete-task)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
  "problems": []
}