          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
        "directory_path": "~/photographs/vacations/"
      }
    },
    {
      "step": 5,
      "pddl": "(file-system-compress-directory spot-dir-1 file-system-token spot-zip-1 flag-true flag-true vacations-dir)",
      "api": "file_system.compress_directory",
      "args": {
        "directory_path": {
          "$from": "file_system.show_directory",
          "field": "1st sub-directory path in the listing of ~/photographs/vacations/ (recursive=false)",
          "object": "spot-dir-1"
        },
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
        "compressed_file_path": {
          "$from": "file_system.show_directory",
          "field": "\"~/photographs/vacations/\" + basename(spot-dir-1) + \".zip\"",
          "object": "spot-zip-1"
        },
        "delete_directory": true,
        "overwrite": true
      }
    },
