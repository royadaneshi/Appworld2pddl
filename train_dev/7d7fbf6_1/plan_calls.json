    {
      "step": 3,
      "pddl": "(file-system-login nicholas-weber-at-gmail-com file-system-password file-system-token)",
      "api": "file_system.login",
      "args": {
        "username": "nicholas.weber@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"file_system\"",
          "object": "file-system-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(file-system-show-directory file-system-token vacations-dir)",
