          "object": "spot-dir-2"
        },
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
        "compressed_file_path": {
          "$from": "file_system.show_directory",
          "field": "'~/photos/vacations/' + basename(spot-dir-2) + '.tar'",
          "object": "spot-tar-2"
        },
        "delete_directory": true
      }
    },
    {
      "step": 7,
      "pddl": "(file-system-compress-directory spot-dir-3 file-system-token spot-tar-3 flag-true vacations-dir)",
      "api": "file_system.compress_directory",
      "args": {
        "directory_path": {
          "$from": "file_system.show_directory",
          "field": "3rd sub-directory entry of the returned list",
          "object": "spot-dir-3"
        },
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
