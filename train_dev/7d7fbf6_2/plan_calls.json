{
  "calls": [
    {
      "step": 1,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 2,
      "pddl": "(supervisor-show-profile)",
      "api": "supervisor.show_profile",
      "args": {}
    },
    {
      "step": 3,
      "pddl": "(file-system-login jasonsimp-at-gmail-com file-system-password file-system-token)",
      "api": "file_system.login",
      "args": {
        "username": "jasonsimp@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"file_system\"",
          "object": "file-system-password"
        }
      }
    },
    {
      "step": 4,
      "pddl": "(file-system-show-directory file-system-token vacations-dir)",
      "api": "file_system.show_directory",
      "args": {
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
        "directory_path": "~/photos/vacations/"
      }
    },
    {
      "step": 5,
      "pddl": "(file-system-compress-directory spot-dir-1 file-system-token spot-tar-1 flag-true vacations-dir)",
      "api": "file_system.compress_directory",
      "args": {
        "directory_path": {
          "$from": "file_system.show_directory",
          "field": "1st sub-directory entry of the returned list for directory_path='~/photos/vacations/' (recursive=false), e.g. '~/photos/vacations/<vacation_spot>'",
          "object": "spot-dir-1"
        },
        "access_token": {
          "$from": "file_system.login",
          "field": "access_token",
          "object": "file-system-token"
        },
        "compressed_file_path": {
          "$from": "file_system.show_directory",
          "field": "'~/photos/vacations/' + basename(spot-dir-1) + '.tar'",
          "object": "spot-tar-1"
        },
        "delete_directory": true
      }
    },
    {
      "step": 6,
      "pddl": "(file-system-compress-directory spot-dir-2 file-system-token spot-tar-2 flag-true vacations-dir)",
