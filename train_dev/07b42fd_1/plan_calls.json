{
  "calls": [
    {
      "step": 1,
      "pddl": "(spotify-search-artists query-classical classical count-22)",
      "api": "spotify.search_artists",
      "args": {
        "query": "classical",
        "genre": "classical",
        "min_follower_count": 22
      }
    },
    {
      "step": 2,
      "pddl": "(supervisor-show-account-passwords)",
      "api": "supervisor.show_account_passwords",
      "args": {}
    },
    {
      "step": 3,
      "pddl": "(supervisor-show-profile)",
      "api": "supervisor.show_profile",
      "args": {}
    },
    {
      "step": 4,
      "pddl": "(spotify-login eri-powe-at-gmail-com spotify-password spotify-token)",
      "api": "spotify.login",
      "args": {
        "username": "eri_powe@gmail.com",
        "password": {
          "$from": "supervisor.show_account_passwords",
          "field": "password where account_name == \"spotify\"",
          "object": "spotify-password"
        }
      }
    },
    {
      "step": 5,
      "pddl": "(spotify-follow-artist artist-grace-harrison spotify-token classical count-22)",
      "api": "spotify.follow_artist",
      "args": {
        "artist_id": {
          "$from": "spotify.search_artists",
          "field": "artist_id of the only result with genre == \"classical\" and follower_count >= 22 across all pages (Grace Harrison)",
          "object": "artist-grace-harrison"
        },
        "access_token": {
          "$from": "spotify.login",
          "field": "access_token",
          "object": "spotify-token"
        }
      }
    },
    {
      "step": 6,
      "pddl": "(supervisor-complete-task)",
      "api": "supervisor.complete_task",
      "args": {}
    }
  ],
  "problems": []
